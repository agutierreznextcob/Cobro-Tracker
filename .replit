modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-money-flow"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-public-routes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-auth-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-invitacion"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-invitacion-browser"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-money-flow"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec tsx scripts/e2e-money-flow.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-public-routes"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec tsx scripts/e2e-public-routes.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "check-auth-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run check:auth-guards"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "e2e-invitacion"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec tsx scripts/e2e-invitacion.ts"

[[workflows.workflow]]
name = "e2e-invitacion-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test --reporter=list"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 23803
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "at-spi2-atk", "cups", "dbus", "libdrm", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "mesa", "expat", "libxkbcommon", "alsa-lib", "libGL", "libgbm", "xorg.libXau", "xorg.libXdmcp", "xorg.libXi", "xorg.libXinerama", "xorg.libXcursor", "xorg.libXrender", "xorg.libXft", "xorg.libXmu", "wayland"]

[userenv]

[userenv.shared]
WEBHOOK_SECRET = "e55976eab6a0041aaa3b76d44f4ab8f71a69d02f7a71a1af49e271c05af274e3"
RESEND_FROM_EMAIL = "cobros@nextcob.com"

[userenv.production]
APP_PUBLIC_URL = "https://cobro-tracker--anibalguti.replit.app"
