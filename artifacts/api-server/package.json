{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:cotizacion-storage": "tsx scripts/test-cotizacion-storage-live.ts",
    "test:cotizacion-resend": "tsx scripts/test-cotizacion-resend-live.ts",
    "test:cotizacion-resend:offline": "tsx --test scripts/test-cotizacion-resend-contract.ts",
    "test:logo-cleanup-storage": "tsx scripts/test-empresa-logo-storage-live.ts",
    "check:auth-guards": "tsx --test scripts/test-auth-guards.ts && tsx scripts/check-auth-guards.ts",
    "e2e:notificaciones": "tsx scripts/e2e-notificaciones.ts",
    "e2e:team-scope": "tsx scripts/e2e-team-scope.ts",
    "e2e-sweep-health": "tsx scripts/e2e-sweep-health.ts",
    "test-cobros-avanzados": "tsx scripts/test-cobros-avanzados.ts",
    "e2e:cobros-avanzados": "tsx scripts/test-cobros-avanzados.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.3",
    "groq-sdk": "^1.2.1",
    "openid-client": "^6.8.4",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
